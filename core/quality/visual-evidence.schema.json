{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/visual-evidence.schema.json",
  "title": "VisualEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["route", "viewport", "diff_hash"],
  "properties": {
    "route": { "type": "string", "minLength": 1 },
    "viewport": { "type": "string", "minLength": 1 },
    "diff_hash": { "type": "string", "minLength": 1 },
    "screenshot": { "type": ["string", "null"] },
    "baseline": { "type": ["string", "null"] },
    "baseline_missing_reason": { "type": ["string", "null"] },
    "trace": { "type": ["string", "null"] },
    "console_error_count": { "type": "integer", "minimum": 0 },
    "failed_request_count": { "type": "integer", "minimum": 0 },
    "reviewer_status": {
      "type": ["string", "null"],
      "enum": ["PASS", "FAIL", "PENDING", null]
    },
    "console_messages": {
      "type": "array",
      "items": { "type": "string" }
    },
    "failed_request_urls": {
      "type": "array",
      "items": { "type": "string" }
    },
    "limitation": { "type": ["string", "null"] },
    "base_commit": { "type": ["string", "null"] }
  }
}
