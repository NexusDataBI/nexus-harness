{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/ci-profile.schema.json",
  "title": "CiProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "components"],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "global_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Fail-closed paths nested under [project] (tomllib footgun fallback)."
        },
        "fail_closed_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Alias for project.global_paths."
        }
      }
    },
    "global_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Fail-closed critical paths; any match marks every component."
    },
    "fail_closed_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Alias for global_paths."
    },
    "components": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/component" }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_url", "readiness_url", "dev_server"],
      "properties": {
        "base_url": { "type": "string", "minLength": 1 },
        "readiness_url": { "type": "string", "minLength": 1 },
        "visual_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "dev_server": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command"],
          "properties": {
            "command": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 },
              "description": "Argv list only. A shell string is malformed."
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "routes": {
          "type": "array",
          "items": { "$ref": "#/$defs/frontendRoute" }
        },
        "playwright": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "video": {
              "type": "boolean",
              "description": "Opt-in only. Default false; retain video on failure when true."
            }
          }
        },
        "viewports": {
          "type": "array",
          "items": { "$ref": "#/$defs/frontendViewport" }
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional PostHog Cloud identifiers. Never include tokens.",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "description": "Observability provider id (e.g. posthog)."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Project/observability identifier — never a secret."
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "description": "https PostHog Cloud host/region base URL."
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "description": "Optional PostHog Cloud region label (e.g. us, eu)."
        }
      }
    }
  },
  "$defs": {
    "frontendViewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "width", "height"],
      "properties": {
        "name": { "type": "string", "enum": ["desktop", "mobile"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "frontendRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths"],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "depends_on": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "checks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "images": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "exclude": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Paths that match paths but must not select this component."
        },
        "dockerfile": {
          "type": "string",
          "minLength": 1,
          "description": "Dockerfile path for this component's image(s); required to build."
        },
        "context": {
          "type": "string",
          "minLength": 1,
          "description": "Docker build context path (default '.')."
        },
        "image_name": {
          "type": "string",
          "minLength": 1,
          "description": "Optional registry service slug override (else first images[] entry)."
        }
      }
    }
  }
}
