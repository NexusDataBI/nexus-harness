{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/task-state.schema.json",
  "title": "TaskState",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "repo_id", "stage", "acceptance", "stage_status"],
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "repo_id": { "type": "string", "minLength": 1 },
    "stage": { "type": "integer", "minimum": 0, "maximum": 9 },
    "acceptance": {
      "type": "array",
      "items": { "$ref": "acceptance.schema.json" }
    },
    "stage_status": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "PENDING",
          "PASS",
          "FAIL",
          "SKIP",
          "BLOCKED",
          "WAITING_APPROVAL"
        ]
      }
    },
    "issue": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "tracking_required": { "type": "boolean" },
    "current_diff_hash": { "type": ["string", "null"] }
  }
}
