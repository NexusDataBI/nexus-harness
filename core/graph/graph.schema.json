{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/graph.schema.json",
  "title": "TaskGraph",
  "type": "object",
  "additionalProperties": false,
  "required": ["nodes"],
  "properties": {
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stage",
        "kind",
        "dependencies",
        "reads",
        "writes",
        "affected_paths",
        "risk",
        "execution_target",
        "estimated_cost",
        "status",
        "evidence_outputs"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "stage": { "type": "integer", "minimum": 0, "maximum": 9 },
        "kind": { "type": "string" },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reads": {
          "type": "array",
          "items": { "type": "string" }
        },
        "writes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "affected_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "risk": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "execution_target": {
          "type": "string",
          "enum": ["local", "self_hosted", "github_hosted"]
        },
        "estimated_cost": { "type": "number", "minimum": 0 },
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "PASS",
            "FAIL",
            "SKIP",
            "BLOCKED",
            "WAITING_APPROVAL"
          ]
        },
        "evidence_outputs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "from", "to"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "depends_on",
            "invalidates",
            "conflicts_with",
            "requires_gate",
            "produces_for",
            "promotes"
          ]
        },
        "from": { "type": "string" },
        "to": { "type": "string" }
      }
    }
  }
}
