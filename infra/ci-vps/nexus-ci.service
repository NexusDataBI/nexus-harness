[Unit]
Description=Nexus CI GitHub Actions Runner
Documentation=file:///opt/nexus-runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nexus-ci
Group=nexus-ci
WorkingDirectory=/opt/nexus-runner
ExecStart=/opt/nexus-runner/run.sh
Restart=always
RestartSec=10
KillMode=process
TimeoutStopSec=30
# Bounded environment — no production secrets injected here.
Environment=HOME=/home/nexus-ci
Environment=RUNNER_WORK_FOLDER=/var/lib/nexus-ci/cache/_work
# Prefer rootless Docker when the per-user socket exists.
Environment=DOCKER_HOST=unix:///home/nexus-ci/.docker/run/docker.sock
# Soft hardening; do not grant elevated capabilities.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/nexus-runner /var/lib/nexus-ci /home/nexus-ci

[Install]
WantedBy=multi-user.target
